{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:unit": "node --test --no-warnings admin-dashboard/src/lib/*.test.ts packages/db/src/*.test.ts",
    "db:generate": "node packages/db/scripts/prisma.mjs generate",
    "db:push": "node packages/db/scripts/prisma.mjs push",
    "db:prepare": "node packages/db/scripts/prisma.mjs prepare",
    "dev:checkout": "npm run db:generate && nx run checkout:dev",
    "dev:admin-dashboard": "npm run db:generate && PORT=3001 nx run admin-dashboard:dev",
    "build": "npm run db:generate && nx run-many --target=build --projects=checkout,admin-dashboard"
  },
  "private": true,
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@nx/devkit": "23.3.0",
    "@nx/js": "23.2.0",
    "@nx/next": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "nx": "23.2.0",
    "postcss": "^8.5.6",
    "prisma": "6.19.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.16",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3"
  },
  "workspaces": [
    "packages/*",
    "checkout",
    "admin-dashboard"
  ],
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "prisma@6.19.0": true
  }
}
