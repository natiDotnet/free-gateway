{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "rootDir": ".",
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedSideEffectImports": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./admin-dashboard/src/*", "./checkout/src/*"],
      "@org/db": ["./packages/db/src/prisma.ts"],
      "@org/chapa": ["./packages/chapa/src/lib/chapa.ts"],
      "@org/store": ["./packages/store/src/payment-store.ts"]
    }
  },
  "include": [
    "checkout/src/**/*.ts",
    "checkout/src/**/*.tsx",
    "admin-dashboard/src/**/*.ts",
    "admin-dashboard/src/**/*.tsx",
    "packages/db/src/**/*.ts",
    "packages/chapa/src/**/*.ts",
    "packages/store/src/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
